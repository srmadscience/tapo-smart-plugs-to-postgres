# Copy to .env and fill in. Do NOT commit real credentials.
# Load with:  set -a; source .env; set +a

# Tapo (TP-Link) account the plugs are registered to. Used for LOCAL login
# only (TPAP/KLAP); both values are case-sensitive. Third-Party Compatibility
# must be enabled in the Tapo app (Me > Third-Party Services).
TAPO_USERNAME=you@example.com
TAPO_PASSWORD=changeme

# Plug list (tapo.plug). The watcher's only direct DB access; cached in
# state/plugs.json for PostgreSQL outages.
TAPO_PG_DSN="host=postgres port=5432 dbname=tapo_db user=changeme password=changeme"

# Kafka + schema registry (placeholders; set to your own hosts).
KAFKA_BOOTSTRAP=kafka:9092
SCHEMA_REGISTRY_URL=http://kafka:8081

# Used only by connect/install-sinks.sh to fill CHANGEME_* in connect/*.json
# (it also uses SCHEMA_REGISTRY_URL above).
PG_USER=changeme
PG_PASSWORD=changeme
PG_JDBC_URL=jdbc:postgresql://postgres:5432/tapo_db

# Kafka Connect REST, used each run to restart FAILED tapo sinks (empty disables).
CONNECT_URL=http://kafka:8083

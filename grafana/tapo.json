{
  "__inputs": [
    {
      "name": "DS_TAPO_POSTGRES",
      "label": "PostgreSQL (endowment_db)",
      "description": "PostgreSQL holding the tapo.* tables",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "uid": "tapo-plugs",
  "title": "Tapo smart plugs",
  "tags": [
    "tapo",
    "energy"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "plug",
        "label": "Plug",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_TAPO_POSTGRES}"
        },
        "query": "SELECT plug_name FROM tapo.plug WHERE enabled ORDER BY 1",
        "definition": "SELECT plug_name FROM tapo.plug WHERE enabled ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "id": 2,
      "title": "Power now",
      "description": "Latest reading per plug (polled every 15 min). Plugs not heard from in the last hour are omitted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (plug_name) plug_name AS metric, (current_power_mw / 1000.0)::float8 AS watts\nFROM tapo.reading\nWHERE status = 'ok' AND plug_name IN ($plug) AND fetched_at > now() - interval '1 hour'\nORDER BY plug_name, fetched_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "displayName": "${__data.fields.metric}",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 16,
        "namePlacement": "left"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Energy today",
      "description": "Sum of each plug's own today_energy counter (plug-local day).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(today_energy_wh), 0)::float8 / 1000 AS \"Today (kWh)\"\nFROM (SELECT DISTINCT ON (plug_name) today_energy_wh\n      FROM tapo.reading\n      WHERE status = 'ok' AND plug_name IN ($plug) AND fetched_at > now() - interval '1 hour'\n      ORDER BY plug_name, fetched_at DESC) latest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Energy in selected range",
      "description": "From the plugs' hourly energy history, so it includes hours backfilled after outages.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(energy_wh), 0)::float8 / 1000 AS \"Selected range (kWh)\"\nFROM tapo.energy_hourly\nWHERE $__timeFilter(interval_start) AND plug_name IN ($plug)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Minutes since last good reading",
      "description": "Feed staleness per enabled plug. Runs every 15 min, so above ~20 means a missed poll; above 35, two.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.plug_name AS metric,\n       (EXTRACT(EPOCH FROM now() - MAX(r.fetched_at)) / 60)::float8 AS minutes\nFROM tapo.plug p\nLEFT JOIN tapo.reading r ON r.plug_name = p.plug_name AND r.status = 'ok'\nWHERE p.enabled AND p.plug_name IN ($plug)\nGROUP BY p.plug_name ORDER BY p.plug_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "displayName": "${__data.fields.metric}",
          "decimals": 0,
          "noValue": "never",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 35
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      }
    },
    {
      "type": "row",
      "id": 6,
      "title": "Power and energy",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Power (5-minute average)",
      "description": "tapo.power_5min: the plug's own 5-minute average power. Gaps are slots the plug had no data for.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT interval_start AS time, plug_name AS metric, power_w::float8 AS value\nFROM tapo.power_5min\nWHERE $__timeFilter(interval_start) AND plug_name IN ($plug)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Energy per hour",
      "description": "tapo.energy_hourly, stacked by plug.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT interval_start AS time, plug_name AS metric, energy_wh::float8 AS value\nFROM tapo.energy_hourly\nWHERE $__timeFilter(interval_start) AND plug_name IN ($plug)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watth",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Energy per day",
      "description": "Hourly energy summed per Europe/Dublin calendar day, stacked by plug.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (date_trunc('day', interval_start AT TIME ZONE 'Europe/Dublin') AT TIME ZONE 'Europe/Dublin') AS time,\n       plug_name AS metric, (SUM(energy_wh) / 1000.0)::float8 AS value\nFROM tapo.energy_hourly\nWHERE $__timeFilter(interval_start) AND plug_name IN ($plug)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 10,
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "type": "table",
      "id": 11,
      "title": "Plug status",
      "description": "Latest poll per plug. RSSI: below -80 dBm is unreliable (the washing machine plug dropped out at -98).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (r.plug_name)\n       r.plug_name AS \"Plug\", r.status AS \"Status\", r.fetched_at AS \"Last poll\",\n       r.device_on AS \"On\", (r.current_power_mw / 1000.0)::float8 AS \"Power (W)\",\n       r.rssi AS \"RSSI (dBm)\", r.signal_level AS \"Signal\", d.model AS \"Model\",\n       d.fw_ver AS \"Firmware\", r.ip AS \"IP\", r.error AS \"Last error\"\nFROM tapo.reading r\nLEFT JOIN tapo.device d ON d.plug_name = r.plug_name\nWHERE r.plug_name IN ($plug)\nORDER BY r.plug_name, r.fetched_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "error": {
                        "color": "red",
                        "index": 1
                      },
                      "auth_backoff": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RSSI (dBm)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": -80
                    },
                    {
                      "color": "green",
                      "value": -70
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last poll"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Power (W)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Firmware"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 240
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last error"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 400
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Wi-Fi signal (RSSI)",
      "description": "Below -80 dBm (red zone) a plug is likely to drop off Wi-Fi.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT fetched_at AS time, plug_name AS metric, rssi::float8 AS value\nFROM tapo.reading\nWHERE $__timeFilter(fetched_at) AND plug_name IN ($plug) AND rssi IS NOT NULL\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: dBm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 1800000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "max": -30,
          "min": -100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "transparent",
                "value": -80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Failed polls per hour",
      "description": "Readings with status error or auth_backoff. 4 per hour means the plug was unreachable all hour.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TAPO_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TAPO_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', fetched_at) AS time, plug_name AS metric,\n       (COUNT(*) FILTER (WHERE status <> 'ok'))::float8 AS value\nFROM tapo.reading\nWHERE $__timeFilter(fetched_at) AND plug_name IN ($plug)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 1
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}

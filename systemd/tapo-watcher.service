# Template — install with systemd/install-service.sh, which fills @PLACEHOLDERS@.
#
# One-shot: poll every plug once, write the outbox file, drain it to Kafka.
# Scheduling is handled by tapo-watcher.timer, not by this unit.
[Unit]
Description=Tapo smart plug watcher (one poll -> outbox -> Kafka)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
# buffer/ (outbox) and state/ (plug-list cache, poll state) live here.
WorkingDirectory=@REPO_DIR@
# Secrets (TAPO_PASSWORD, TAPO_PG_DSN) come from here, not the command line.
EnvironmentFile=@ENVFILE@
ExecStart=@REPO_DIR@/.venv/bin/tapo-watcher
# Plugs are polled concurrently (60s cap each) + a drain capped at 120s.
TimeoutStartSec=600
Nice=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

# Secrets + per-host settings for the tapo-watcher systemd service.
#
# install-service.sh copies this to /etc/tapo-watcher/tapo-watcher.env
# (root-owned, chmod 600). Edit that copy — NOT this template — with real values.

# Tapo account the plugs are registered to (local login; case-sensitive).
TAPO_USERNAME=you@example.com
TAPO_PASSWORD=changeme
# Read-only access to tapo.plug (the plug list). libpq DSN or URI.
TAPO_PG_DSN="host=postgres port=5432 dbname=tapo_db user=changeme password=changeme"
# Kafka, schema registry and Kafka Connect REST. The defaults in config.py
# are placeholders, so set these to your own hosts.
KAFKA_BOOTSTRAP=kafka:9092
SCHEMA_REGISTRY_URL=http://kafka:8081
CONNECT_URL=http://kafka:8083
